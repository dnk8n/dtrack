# /etc/cron.d/dtrack — scheduled jobs for the single-server stack.
# Install, with your checkout path in place of /opt/dtrack:
#   sed "s|/opt/dtrack|$APP_DIR|g" deploy/cron.d-dtrack | sudo install -m 644 /dev/stdin /etc/cron.d/dtrack
# Backup location, group and retention are set in .env. Output goes to the
# journal: journalctl -t dtrack-backup / -t dtrack-keys
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Nightly database backup into BACKUP_DIR from .env (default /var/backups/dtrack).
15 1 * * * root /opt/dtrack/deploy/backup-db.sh 2>&1 | logger -t dtrack-backup

# Refresh the Entra ID signing keys PostgREST checks tokens against.
40 */6 * * * root /opt/dtrack/rotate-keys.sh 2>&1 | logger -t dtrack-keys

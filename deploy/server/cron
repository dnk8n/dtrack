# /etc/cron.d/dtrack — scheduled jobs for a DTrack server, installed by
# install.sh with @DIR@ replaced by the install directory. Output goes to the
# journal: journalctl -t dtrack-backup / -t dtrack-keys
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Nightly database backup into BACKUP_DIR (from .env), RETAIN_DAYS kept.
15 1 * * * root cd @DIR@ && docker compose run --rm -T ops backup 2>&1 | logger -t dtrack-backup

# Refresh the Entra ID signing keys PostgREST checks tokens against.
40 */6 * * * root cd @DIR@ && docker compose run --rm -T ops rotate-keys 2>&1 | logger -t dtrack-keys

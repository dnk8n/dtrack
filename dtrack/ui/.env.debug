# Loaded only by Vite's debug mode (vite --mode debug, or the Docker build arg
# BUILD_MODE=debug via config/docker-compose.overrides/debug.yaml). Production
# builds never read this file, so its value never reaches a deployable image.
#
# The secret below is public and debug-only: PostgREST trusts it only when
# started with debug.yaml. It lets the debug login page sign its own JWTs.
# Never reuse it anywhere else.
VITE_ENVIRONMENT=DEBUG
VITE_JWT_SECRET=Dummy5ecr3t4D3bug0n1yN0T4Pr0D123

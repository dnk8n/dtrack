# Loaded only by Vite's demo mode (vite --mode demo, or the Docker build arg
# BUILD_MODE=demo via config/docker-compose.overrides/demo.yaml). Production
# builds never read this file, so its value never reaches a deployable image.
#
# The secret below is public and demo-only: PostgREST trusts it only when
# started with demo.yaml. It lets the demo login page sign its own JWTs.
# Never reuse it anywhere else, and never run demo mode on a live server.
VITE_ENVIRONMENT=DEMO
VITE_JWT_SECRET=Dummy5ecr3t4D3m00n1yN0T4Pr0D1234
